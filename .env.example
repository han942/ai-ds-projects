#my-sql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=

#NLP-Newspaper (fine-tuning pipeline)
HUGGINGFACE_HUB_TOKEN=

#NLP-Newspaper (LangChain AI agent)
# OpenAI — required to run the agent
OPENAI_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o-mini
# LangSmith — optional execution tracing (independent of Langfuse)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=NLP-Newspaper-Agent
# Langfuse — optional; when unset, tracing/prompt-management degrade to no-ops
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
