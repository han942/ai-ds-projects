# Hugging Face (required by the fine-tuning notebook)
HUGGINGFACE_HUB_TOKEN=

# OpenRouter (recommended for C0 / Agent experiments; when set, OpenRouter is used)
# Set OPENROUTER_MODEL to your chosen model ID (e.g. a `:free` model on OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
# Optional OpenRouter attribution headers
# OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=NLP-Newspaper-CUAI

# OpenAI (used when OPENROUTER_API_KEY is not set)
OPENAI_API_KEY=

# Optional model and agent overrides
# OPENAI_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o-mini
# AGENT_MAX_TOKENS=4000
# AGENT_TEMPERATURE=0.3
# AGENT_EFFORT=medium
# AGENT_TIMEOUT=90.0
# TARGET_READER=초등학교 고학년~중학생 (upper-elementary to middle-school students)
# MAX_REFINE_ITERS=2

# LangSmith (API key required for Studio; remote tracing is optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=NLP-Newspaper-Agent

# Langfuse (optional tracing and prompt management)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
