# Hugging Face (required by the fine-tuning notebook)
HUGGINGFACE_HUB_TOKEN=

# OpenAI (required by the LangChain agent)
OPENAI_API_KEY=

# Optional model and agent overrides
# OPENAI_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o-mini
# AGENT_MAX_TOKENS=4000
# AGENT_TEMPERATURE=0.3
# AGENT_EFFORT=medium
# TARGET_READER=초등학교 고학년~중학생
# MAX_REFINE_ITERS=2

# LangSmith (API key required for Studio; remote tracing is optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=NLP-Newspaper-Agent

# Langfuse (optional tracing and prompt management)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PROMPT_LABEL=production
