.env
.venv/
*.pyc
__pycache__/
.pytest_cache/
crawler/data/
mlruns/

# Local experiment outputs. Only the folder guide and each run's report are
# versioned; everything else under artifacts/ stays on this machine.
artifacts/*
!artifacts/README.md
!artifacts/runs/
artifacts/runs/*/*
!artifacts/runs/*/report.md
!artifacts/comparisons/
artifacts/comparisons/*/*/*
!artifacts/comparisons/*/*/report.md
!artifacts/comparisons/*/*/learning_curve.png
