# Copy this file to .env. Never commit the real values.
#
# Supabase Dashboard > Connect:
# - Prefer Direct connection for migrations when IPv6 is available.
# - Otherwise use the Session pooler on port 5432.
# - Keep sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_PW=replace-with-your-supabase-password

# Stable secret used to pseudonymize source user names.
# Generate once, keep it unchanged, and do not commit it.
USER_HASH_SALT=replace-with-a-long-random-secret

# Optional. This is the default when omitted.
RECSYS_INPUT_DIR=legacy/v1_rating_prediction/crawled_data

# OpenRouter review-embedding candidate experiment
OPENROUTER_API_KEY=
